# Copy this file to `.env` for local development.
# Railway: set the same keys as project variables in the service settings.

# Public URL of the deployed Next.js frontend, used for CORS.
# Example: https://flume.vercel.app
FRONTEND_URL=

# Supabase project credentials (server-side only - never expose these
# to the browser or commit real values to source control).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# MiniMax API key (used by the intake/underwriting agents in a later stage).
MINIMAX_API_KEY=

# Port the server binds to. Railway injects this automatically in production.
PORT=8000
