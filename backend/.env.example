# Copy this file to `.env` and fill in the values for local development.
# Railway: set the same keys as project variables in the service settings.

# General
APP_NAME="Flume API"
ENVIRONMENT=development
DEBUG=true

# Comma separated list of origins allowed to call the API (no trailing slash)
CORS_ORIGINS=http://localhost:3000

# Port the server binds to. Railway injects this automatically in production.
PORT=8000
